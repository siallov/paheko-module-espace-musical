{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "association": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "location": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "season": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "rehearsal": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "venue": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "hero_title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "hero_intro": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "hero_eyebrow": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "concert_title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "join_title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "join_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "contact_title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "contact_intro": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "dossier": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "lien_ajout": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "converter_url": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    },
    "converter_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "primary_color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "background_color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "accent_color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "type": {
      "const": "public_settings",
      "type": "string"
    }
  },
  "required": [
    "association"
  ],
  "additionalProperties": true
}
